APP_PORT=4000
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# Optional: path to the SQLite database file (defaults to ./database.sqlite)
# DB_PATH=./database.sqlite

# Firebase Admin SDK — obtain from:
# Firebase Console > Project Settings > Service Accounts > Generate new private key
ADMIN_SDK_PROJECT_ID=your_project_id
ADMIN_SDK_PRIVATE_KEY_ID=your_private_key_id
ADMIN_SDK_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
ADMIN_SDK_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
ADMIN_SDK_CLIENT_ID=your_client_id

# Admin user — created automatically on backend startup
ADMIN_EMAIL=admin@booklib.com
ADMIN_PASSWORD=Admin@123456
