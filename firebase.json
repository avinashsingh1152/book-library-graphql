{
  "functions": [
    {
      "source": "backend",
      "codebase": "api",
      "runtime": "nodejs22",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log"]
    }
  ],
  "hosting": {
    "public": "frontend/out",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/graphql",
        "function": "api",
        "region": "us-central1"
      },
      {
        "source": "/authors/**",
        "destination": "/authors/index.html"
      },
      {
        "source": "/books/**",
        "destination": "/books/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  }
}
